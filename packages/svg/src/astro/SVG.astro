---
import type { HTMLAttributes } from "astro/types";
import { mergeSvgAttributes, type WebSvgOptions } from "../core/web";
import { loadAstroSvg } from "./runtime";

export interface Props extends Omit<HTMLAttributes<"svg">, "style">, WebSvgOptions {
  style?: string;
}

const { src, name, fetchOptions, cache = true, sanitize = true, onSvgLoad, onSvgError, ...attributes } = Astro.props;
let content;
try {
  content = await loadAstroSvg({ src, name, fetchOptions, cache, sanitize, onSvgLoad }, Astro.url);
} catch (cause) {
  const error = cause instanceof Error ? cause : new Error("Failed to load SVG.");
  onSvgError?.(error);
}
const attrs = content ? { ...attributes, ...mergeSvgAttributes(content, attributes) } : {};
---

{content ? <svg {...attrs} set:html={content.innerHTML} /> : <slot name="fallback" />}
