---
import type { HTMLAttributes } from "astro/types";
import { mergeSvgAttributes, type WebSvgOptions } from "../core/web";
import { loadAstroSvg } from "./runtime";
export { registerLocalSvgs } from "../core/local";

import { createSvgPresentation, type SvgPresentation } from "../core/presentation";

export interface Props extends Omit<HTMLAttributes<"svg">, "style">, WebSvgOptions, SvgPresentation {
  style?: string;
}

const { size, title, desc, src, name, fetchOptions, cache = true, sanitize = true, uniqueIds = true, onSvgLoad, onSvgError, ...attributes } = Astro.props;
let content;
try {
  content = await loadAstroSvg({ src, name, fetchOptions, cache, sanitize, uniqueIds, onSvgLoad }, Astro.url);
} catch (cause) {
  const error = cause instanceof Error ? cause : new Error("Failed to load SVG.");
  onSvgError?.(error);
}
if (content) content = { ...content, ...createSvgPresentation()(content, { title, desc }) };
const attrs = content ? { ...attributes, ...mergeSvgAttributes(content, { ...attributes, size }) } : {};
---

{content ? <svg {...attrs} set:html={content.innerHTML} /> : <slot name="fallback" />}
